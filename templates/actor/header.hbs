{{! Sheet Header }}
<header class='sheet-header'>
  <div id="stat-panel" class="character-header-panel">
    <img
      class='profile-img'
      src='{{actor.img}}'
      data-edit='img'
      data-action='onEditImage'
      data-tooltip='{{actor.name}}'
    />
    <div class='document-name'>
      <input
        name='name'
        type='text'
        value='{{actor.name}}'
        placeholder='Name'
      />
    </div>
    <div id="stat-wizard">
      <h2 class="stat-title">Wizard</h2>
      <input class="stat-value" name="stats.wizard" data-dtype="Number" value="{{system.wizard.value}}" readonly="readonly"/>
      <img class="stat-roll-single expand no-border" title="{{localize 'DEF_WIZ.WizardRollTooltip'}}" data-roll="1d6" src="/systems/definitely-wizards/resources/icons/die-six.svg" />
      <img class="stat-roll-double expand no-border" title="{{localize 'DEF_WIZ.WizardRollWithWitTooltip'}}" data-roll="2d6kl" src="/systems/definitely-wizards/resources/icons/die-six-double.svg" />
      <img class="stat-button-plus no-border expand" title="{{localize 'DEF_WIZ.AddToWizardTooltip'}}" src="/systems/definitely-wizards/resources/icons/plus.svg" />
      <img class="stat-button-minus no-border expand" title="{{localize 'DEF_WIZ.RemoveFromWizardTooltip'}}" src="/systems/definitely-wizards/resources/icons/minus.svg" />
      <img class="stat-button-reset no-border expand" title="{{localize 'DEF_WIZ.ResetWizardTooltip'}}" src="/systems/definitely-wizards/resources/icons/reset.svg" />
    </div>
    <div id="stat-wild">
      <h2 class="stat-title">Wild</h2>
      <input class="stat-value" name="stats.wild" data-dtype="Number" value="{{system.wild.value}}" readonly="readonly"/>
      <img class="stat-roll-single expand no-border" title="{{localize 'DEF_WIZ.WizardRollTooltip'}}" data-roll="1d6" src="/systems/definitely-wizards/resources/icons/die-six.svg" />
      <img class="stat-roll-double expand no-border" title="{{localize 'DEF_WIZ.WizardRollWithWitTooltip'}}" data-roll="2d6kl" src="/systems/definitely-wizards/resources/icons/die-six-double.svg" />
      <img class="stat-button-plus no-border expand" title="{{localize 'DEF_WIZ.AddToWizardTooltip'}}" src="/systems/definitely-wizards/resources/icons/plus.svg" />
      <img class="stat-button-minus no-border expand" title="{{localize 'DEF_WIZ.RemoveFromWizardTooltip'}}" src="/systems/definitely-wizards/resources/icons/minus.svg" />
      <img class="stat-button-reset no-border expand" title="{{localize 'DEF_WIZ.ResetWizardTooltip'}}" src="/systems/definitely-wizards/resources/icons/reset.svg" />
    </div>
    </div>
  </div>
</header>