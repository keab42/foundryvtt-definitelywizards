{
  "name": "definitely-wizards",
  "version": "1.5.0",
  "description": "Definitely Wizards system for Foundry VTT v14",
  "type": "module",
  "private": true,
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check:foundry": "node scripts/check-foundry.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:foundry",
    "prepare": "lefthook install"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "lefthook": "^1.11.0",
    "typescript": "^5.8.0"
  }
}
