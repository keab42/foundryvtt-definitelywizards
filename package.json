{
  "name": "definitely-wizards",
  "version": "3.0.0",
  "description": "CSS compiler for the DefWiz system",
  "scripts": {
    "build": "sass src/scss/definitely-wizards.scss css/definitely-wizards.css --style=expanded --no-source-map",
    "watch": "npm-run-all --parallel watch:sass",
    "watch:sass": "sass src/scss/definitely-wizards.scss css/definitely-wizards.css --style=expanded --source-map --watch",
    "createSymlinks": "node src/create-symlinks.mjs"
  },
  "browserslist": [
    "last 3 versions"
  ],
  "author": "Asacolips",
  "license": "MIT",
  "private": true,
  "devDependencies": {
    "@rayners/foundry-test-utils": "^1.1.1",
    "jest": "^30.1.3",
    "js-yaml": "^4.1.0",
    "npm-run-all": "^4.1.5",
    "sass": "^1.53.0"
  }
}
